{
  "_metadata": {
    "major_version": 1
  },
  "display_information": {
    "name": "Career Break Agent",
    "description": "Personal career job discovery and analysis agent",
    "background_color": "#1F2937"
  },
  "features": {
    "bot_user": {
      "display_name": "career_break",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
